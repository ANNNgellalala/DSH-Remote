# Build outputs
bin/
obj/
*.user
.vs/

# Machine-local scratch (probe projects, screenshots, curl dumps, isolated DSH homes)
_scratch/
_work/

# Local build sandbox (MSBuild artifacts redirected here when the file sandbox blocks the default
# bin/obj paths; also holds the replay probe)
build/

# TLS material generated by scripts/gen-tls.ps1 (private keys stay local)
relay/certs/

# Local runtime artifacts
*.log

# Release signing material + distribution artifacts (never commit)
app/keys/
dist/
*.apk
*.keystore
*.jks
*.pfx
*.p12

# Machine-local deployment settings (real hosts, accounts, tool paths)
config/dshremote.settings.json

# Machine-local NuGet override (private feeds / absolute package paths)
NuGet.config

# Material extracted from the closed-source DSH installation (research only)
scripts/_extract*/
scripts/remote-contract.json

# Third-party signing tool bundle (not redistributed)
OPPOSign/

# Real-device screenshots and logs (private session content)
docs/evidence/

